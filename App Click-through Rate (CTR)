SELECT app_id,
ROUND(100.0*
SUM(
  CASE
    WHEN event_type = 'click' AND EXTRACT(YEAR FROM timestamp) = 2022 THEN 1
    ELSE 0
  END
) /
SUM(
  CASE
    WHEN event_type = 'impression' AND EXTRACT(YEAR FROM timestamp) = 2022 THEN 1
    ELSE 0
  END
),2)
AS ctr
FROM events
GROUP BY app_id
