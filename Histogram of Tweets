Sol 1
WITH CTE AS (
SELECT * FROM tweets
WHERE EXTRACT(YEAR FROM tweet_date) = "2022"
),

CTE2 AS (
SELECT user_id AS users_num,
COUNT(tweet_id) AS tweet_bucket
FROM CTE
GROUP BY user_id
)

SELECT tweet_bucket, 
COUNT(users_num)
FROM CTE2
GROUP BY tweet_bucket;

